# Copy this file to .env for local development and replace every placeholder.
# Never commit the real .env file or a real DATABASE_URL.

# Supabase PostgreSQL connection string.
# In Vercel, add this same variable in Project Settings > Environment Variables.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DB_SSL=true

# PORT is used only by npm start locally. Vercel supplies its own runtime port.
PORT=3000

# Accounts listed here are administrators. Everyone else is a read-only user.
ADMIN_EMAILS=your-admin-email@example.com

# Optional: creates the administrator above on first start when it does not exist yet.
# Leave empty once the account exists, and never commit a real password.
ADMIN_PASSWORD=replace-with-a-new-password

# Public self-registration. Leave false so only an administrator can create accounts.
ALLOW_REGISTRATION=false

# Used by the simulated email-confirmation flow in the authentication API.
CONFIRMATION_CODE_EXPIRY_MINUTES=30
