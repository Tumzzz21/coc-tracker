# Copy to .env and fill in real values. Never commit .env.

# Official CoC API (developer.clashofclans.com)
COC_API_TOKEN=your-api-key-here
CLAN_TAG=#YOURCLANTAG
CLAN_NAME=Your Clan Name

# Local MySQL (XAMPP) — used when DATABASE_URL is not set
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coc_tracker

# Supabase (Vercel production) — set on Vercel, not locally
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Protects POST /api/sync and /api/notes.
# Pick 3+ unrelated words (20+ chars); the app warns when this looks weak.
ADMIN_KEY=choose-a-secret-key

# Trust requests from this machine (loopback) without the admin key, so local
# refreshes never prompt. Set 0 when exposing the app beyond localhost.
ALLOW_LOCAL_SYNC=1

# ---- Day boundary for daily records ----------------------------------------
# Daily capital-coin records are bucketed by the SERVER's local time.
# Locally nothing is needed (this machine already runs at UTC+8).
# On Vercel the runtime is UTC, so set TZ=Asia/Manila there or your "day"
# would flip at 08:00 PH instead of midnight. The header shows a warning
# pill if the server clock is not +08:00.
# TZ=Asia/Manila
#
# Escape hatch: force a fixed offset regardless of the server clock.
# APP_UTC_OFFSET=+08:00

# How often (hours) to refresh the "so far today" reading. Each refresh costs
# one API call per member. 0 keeps only the once-a-day baseline (cheapest).
CONTRIB_SNAPSHOT_HOURS=6

# Local background auto-sync interval (minutes). 0 disables it.
# Vercel uses the cron job in vercel.json instead (set CRON_SECRET there if
# you enable Vercel's cron authentication).
AUTO_SYNC_MINUTES=30
# CRON_SECRET=choose-another-secret

# ---- Key rotation (scripts/refresh_key.py) ---------------------------------
# Supercell pins each API key to the IP addresses you whitelist, so a new
# public IP means HTTP 403 everywhere until the key is replaced:
#
#   python scripts/refresh_key.py --dry-run   # show what it would do
#   python scripts/refresh_key.py             # create a key for this IP
#   python scripts/diagnose.py                # explain any remaining problem
#
# The script can log in to the developer portal and create the key for you.
# COC_DEV_PASSWORD is your Supercell *account* password - far more sensitive
# than the API key. Keep .env out of git and rotate it if it ever leaks.
# COC_DEV_EMAIL=you@example.com
# COC_DEV_PASSWORD=

# After a 403, run the refresh script once from the background sync loop.
# The Task Scheduler route (scripts/refresh_key.cmd) does the same offline.
AUTO_REFRESH_KEY=0

# ---- Diagnostics -----------------------------------------------------------
# Public-IP lookup behind /api/diagnostics; set 0 where egress IPs rotate.
EGRESS_CHECK=1
# EGRESS_IP_LOOKUP_URL=https://api.ipify.org
# Seconds to cache the diagnostics report.
DIAGNOSTICS_TTL=60
