# Copy this file to .env and replace the placeholder values.

# HTTP server configuration
PORT=3000

# MySQL connection configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=clan_tracker
DB_PASSWORD=change_me
DB_NAME=coc_clan_tracker

# Accounts listed here are administrators. Everyone else is a read-only user.
ADMIN_EMAILS=aldrinlance21@gmail.com

# Optional: creates the administrator above on first start when it does not exist
# yet. Leave empty once the account exists, and never commit a real password.
ADMIN_PASSWORD=

# Public self-registration. Leave false so only an administrator can create accounts.
ALLOW_REGISTRATION=false

# In production, set these values in the host's secret/environment settings,
# not in a committed .env file.

# Used by the simulated email-confirmation flow in the authentication API.
CONFIRMATION_CODE_EXPIRY_MINUTES=30
